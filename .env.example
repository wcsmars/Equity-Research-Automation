# Copy to .env and fill in. The backend reads these from the environment.
#
#   cp .env.example .env
#   # then edit .env and run ./run_dev.sh

# EDGAR requests use your own application name and contact email.
# Replace the example contact before making SEC requests.
SEC_USER_AGENT='equity-research your.email@example.com'

# Anthropic powers the optional research assistant.
ANTHROPIC_API_KEY=
# Set a model available to your account if overriding the service default.
# ANTHROPIC_MODEL=

# Financial Modeling Prep — powers the news feed, analyst estimates/price
# targets, and richer TTM multiples. Availability depends on your plan; get a key at
# https://site.financialmodelingprep.com/developer/docs  (the valuation engine
# itself runs on free EDGAR + yfinance and needs no key).
FMP_API_KEY=

# Optional overrides
# FMP_BASE_URL=https://financialmodelingprep.com
# BACKEND_URL=http://127.0.0.1:8000   # used by the Next.js proxy (frontend)
